# 1.1 Redirección 301 Permanente de carniceriacano.com -> carniceriaselcinco.com
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^(www\.)?carniceriacano\.com$ [NC]
    RewriteRule ^(.*)$ https://carniceriaselcinco.com/$1 [R=301,L]
</IfModule>

# ==============================================================================
# CARNICERÍA CANO - Optimización de Rendimiento, Compresión y Caché Apache
# ==============================================================================

# 1. Desactivar listado de directorios
Options -Indexes

# 2. Proteger archivos de configuración y respaldos
<FilesMatch "(^\.env|^\.git|composer\.(json|lock)|\.orig|\.bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Compresión GZIP / Deflate para reducir el peso de texto, CSS y JS un ~75%
<IfModule mod_deflate.c>
    # Comprimir tipos de contenido comunes
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/opentype

    # Compatibilidad con navegadores antiguos
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
</IfModule>

# 4. Cabeceras de Expiración y Caché en Navegador (Browser Caching)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 day"

    # Imágenes (Guardadas en memoria local por 1 mes)
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"

    # Fuentes web (1 año)
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"

    # Hojas de estilo y Scripts (7 días)
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"

    # Documentos HTML dinámicos (No cachear en disco para reflejar cambios de catálogo)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# 5. Cabeceras de Control de Caché HTTP y Seguridad
<IfModule mod_headers.c>
    # Caché estricto para assets estáticos
    <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|woff2?|ttf)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>

    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=604800, public"
    </FilesMatch>

    # Evitar sniff de tipos MIME
    Header set X-Content-Type-Options "nosniff"
</IfModule>
